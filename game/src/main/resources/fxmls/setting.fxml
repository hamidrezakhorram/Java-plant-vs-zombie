<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.SettingController">
   <children>
      <Button layoutX="82.0" layoutY="273.0" mnemonicParsing="false" onMouseClicked="#musicOnAction" text="ON" />
      <Label layoutX="26.0" layoutY="277.0" prefHeight="18.0" prefWidth="65.0" text="Music :" />
      <Button layoutX="133.0" layoutY="273.0" mnemonicParsing="false" onMouseClicked="#musicOffAction" text="OFF" />
      <TextField fx:id="newName" layoutX="133.0" layoutY="36.0" promptText="name" />
      <TextField fx:id="newUsername" layoutX="133.0" layoutY="85.0" promptText="username" />
      <PasswordField fx:id="newPassword" layoutX="133.0" layoutY="135.0" promptText="password" />
      <Button layoutX="300.0" layoutY="36.0" mnemonicParsing="false" onMouseClicked="#changeName" prefHeight="26.0" prefWidth="125.0" text="Change name" />
      <Button layoutX="300.0" layoutY="84.0" mnemonicParsing="false" onMouseClicked="#changeUsername" prefHeight="26.0" prefWidth="125.0" text="Change username" />
      <Button layoutX="300.0" layoutY="134.0" mnemonicParsing="false" onMouseClicked="#changePassword" prefHeight="26.0" prefWidth="125.0" text="Change password" />
   </children>
</AnchorPane>
