<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.SettingController">
   <children>
      <Label layoutX="121.0" layoutY="274.0" prefHeight="31.0" prefWidth="86.0" text="Music :" textFill="#0abd0c">
         <font>
            <Font name="System Bold Italic" size="21.0" />
         </font></Label>
      <TextField fx:id="newName" layoutX="133.0" layoutY="36.0" prefHeight="32.0" prefWidth="150.0" promptText="name" />
      <TextField fx:id="newUsername" layoutX="133.0" layoutY="85.0" prefHeight="32.0" prefWidth="150.0" promptText="username" />
      <PasswordField fx:id="newPassword" layoutX="133.0" layoutY="135.0" prefHeight="30.0" prefWidth="150.0" promptText="password" />
      <Button layoutX="329.0" layoutY="274.0" mnemonicParsing="false" onMouseClicked="#musicOffAction" prefHeight="32.0" prefWidth="66.0" style="-fx-background-color: #FF7903;" text="OFF" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
      <Button layoutX="233.0" layoutY="274.0" mnemonicParsing="false" onMouseClicked="#musicOnAction" prefHeight="32.0" prefWidth="66.0" style="-fx-background-color: #FF7903;" text="ON" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
      <Button layoutX="300.0" layoutY="135.0" mnemonicParsing="false" onMouseClicked="#changePassword" prefHeight="26.0" prefWidth="143.0" style="-fx-background-color: #FF7903;" text="Change Password" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
      <Button layoutX="300.0" layoutY="85.0" mnemonicParsing="false" onMouseClicked="#changeUsername" prefHeight="26.0" prefWidth="143.0" style="-fx-background-color: #FF7903;" text="Change username" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
      <Button layoutX="300.0" layoutY="36.0" mnemonicParsing="false" onMouseClicked="#changeName" prefHeight="26.0" prefWidth="143.0" style="-fx-background-color: #FF7903;" text="Change name" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
      <Button layoutX="34.0" layoutY="444.0" mnemonicParsing="false" onMouseClicked="#backAction" prefHeight="32.0" prefWidth="66.0" style="-fx-background-color: #FF7903;" text="Back" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
